{
  "permissions": {
    "allow": [
      "Bash(flutter analyze *)",
      "Bash(flutter test *)",
      "Bash(dart format *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "PowerShell(flutter analyze *)",
      "PowerShell(flutter test *)",
      "PowerShell(dart format *)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)"
    ],
    "ask": [
      "Bash(git commit *)",
      "PowerShell(git commit *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Bash(git push *)",
      "Bash(git tag *)",
      "PowerShell(git push *)",
      "PowerShell(git tag *)"
    ]
  }
}
